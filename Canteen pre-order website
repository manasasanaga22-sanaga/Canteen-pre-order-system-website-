!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Canteen Pre-Order System</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header>
    <div class="container nav">
      <h1>🍱 Campus Canteen</h1>
      <span class="tag">Pre-Order System</span>
    </div>
  </header>

  <main class="container">
    <section class="hero">
      <div>
        <h2>Order your food before you reach the canteen!</h2>
        <p>Choose your favourite items, add them to your cart and place your pre-order.</p>
      </div>
    </section>

    <section>
      <h2 class="section-title">Today's Menu</h2>
      <div id="menu" class="menu-grid"></div>
    </section>

    <section class="order-area">
      <div class="card">
        <h2>Your Order</h2>
        <div id="cart"></div>
        <div class="total">Total: ₹<span id="total">0</span></div>
        <button id="orderBtn" class="primary">Place Pre-Order</button>
      </div>

      <div class="card">
        <h2>Order Details</h2>
        <label>Name</label>
        <input id="name" type="text" placeholder="Enter your name">
        <label>Pickup Time</label>
        <select id="pickup">
          <option>10:30 AM</option>
          <option>12:30 PM</option>
          <option>1:00 PM</option>
          <option>4:00 PM</option>
        </select>
        <p id="message" class="message"></p>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2026 Campus Canteen • Simple Pre-Order System</p>
  </footer>

  <script src="script.js"></script>
</body>
</html>
